// Lit material with specularity that defines 5 parameters:
// - baseColor
// - roughness
// - specularColor
// - glossiness
//
// These parameters can be used by the application to change the appearance of the material.
//
// This source material must be compiled to a binary material using the matc tool.
// The command used to compile this material is:
// matc -p mobile -a opengl -o app/src/main/assets/lit.filamat app/src/materials/lit.mat
//
// See build.gradle for an example of how to compile materials automatically
// Please refer to the documentation for more information about matc and the materials system.

material {
    name : specular,

    // Dynamic lighting is enabled on this material
    shadingModel : specularGlossiness,

    reflections : screenspace,
    shadowReceiver : true,

    // List of parameters exposed by this material
    parameters : [
        // The color must be passed in linear space, not sRGB
        {
            type : float3,
            name : baseColor
        },
        {
            type : float3,
            name : specularColor
        },
        {
            type : float,
            name : glossiness
        },
        {
            type : float,
            name : ambientOcclusion
        }
    ],
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        // Nothing fancy here, we simply copy the parameters
        material.baseColor.rgb = materialParams.baseColor;
        material.specularColor = materialParams.specularColor;
        material.glossiness = materialParams.glossiness;
        material.ambientOcclusion = materialParams.ambientOcclusion;
    }
}
